# Скопируйте в .env и заполните

# Токен бота от @BotFather (в BotFather включите Bot Settings -> Secretary Mode)
TELEGRAM_BOT_TOKEN=

# Сервер в России: api.telegram.org оттуда не отвечает, нужен свой релей (docs/ПЕРЕНОС.md). Пусто — напрямую.
TELEGRAM_API_URL=

# Второй канал — бот организации в MAX (business.max.ru → чат-боты → токен). Пусто — MAX выключен.
# Менеджер пишет боту /manager, клиенты пишут в бот напрямую
MAX_BOT_TOKEN=
# Mac с включённым VPN: MAX и GigaChat напрямую через Wi-Fi (auto или en0); на сервере не нужно
# Адрес обновляется каждые 30 секунд. Настройки Happ не меняются. Подробнее: docs/DIRECT-CONNECTION.md
DIRECT_INTERFACE=
# Рабочий режим MAX — вебхук: https://ваш-домен/max/webhook и случайный секрет (docs/ПЕРЕНОС.md). Пусто — долгий опрос.
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=

# Провайдер ИИ: gigachat | openai | mock (mock работает без ключей, для тестов)
LLM_PROVIDER=mock

# GigaChat: ключ авторизации из личного кабинета developers.sber.ru (Base64 Client ID:Secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# true, если установлены сертификаты Минцифры; иначе false
GIGACHAT_VERIFY_SSL=false
# Пусто — обычный адрес. Для GigaChat-3-Ultra: https://api.giga.chat/v1 (отвечает только с российского IP)
GIGACHAT_BASE_URL=

# Любой OpenAI-совместимый API. YandexGPT (Yandex AI Studio): OPENAI_BASE_URL=https://ai.api.cloud.yandex.net/v1,
# OPENAI_API_KEY — API-ключ сервисного аккаунта, OPENAI_PROJECT — ID каталога,
# OPENAI_MODEL=gpt://<ID каталога>/yandexgpt (список: GET <base_url>/models)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PROJECT=

# Режим по умолчанию для новых подключений: observe | draft | auto
DEFAULT_MODE=draft

# Пороги
RETRIEVAL_MIN_SCORE=1.0
CONFIDENCE_THRESHOLD=0.7
MANAGER_PAUSE_MINUTES=30
# Сообщения старше стольких минут (бот был выключен) не отвечаем — менеджер мог ответить сам
STALE_MESSAGE_MINUTES=10

# Админка. Токен смените на длинный случайный.
# 127.0.0.1 — админка видна только с этого компьютера; 0.0.0.0 — всей сети
ADMIN_TOKEN=change-me
# Вход по логину и паролю вместо токена — задаётся командой: .venv/bin/python -m app.password
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000

# Пути
DB_PATH=data/app.db
KB_DIR=data/kb
