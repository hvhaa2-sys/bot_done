#!/usr/bin/env bash
# Подготовка стенда ко второй встрече: клиенты пишут, менеджер отвечает на карточки, в «Обучении» появляются кандидаты.
# Сначала в другом окне запустить песочницу с настоящей моделью (из корня проекта):
#     .venv/bin/python -m tools.max_sandbox --admin 8031
# Потом этот скрипт. Утверждение, проверку бота и откат показываем на встрече руками в админке.
# Клиенты и ответы менеджера выдуманные, во внешние мессенджеры ничего не уходит.
set -euo pipefail
BASE="$(cd "$(dirname "$0")/../.." && pwd)"
PY="$BASE/.venv/bin/python"
CHATS="${CHATS:-http://127.0.0.1:8030}"
ADMIN="${ADMIN:-http://127.0.0.1:8031}"
JAR="$(mktemp)"
trap 'rm -f "$JAR"' EXIT

curl -sf "$CHATS/ui/state" >/dev/null || { echo "Песочница не отвечает на $CHATS — запустите tools.max_sandbox"; exit 1; }

send() { curl -sf -X POST "$CHATS/ui/send" -H 'content-type: application/json' -d "$1" >/dev/null; }
say() {  # клиент пишет и ждёт карточку менеджеру
  local before; before=$(cards)
  send "{\"who\":\"$1\",\"text\":\"$2\"}"
  for _ in $(seq 1 40); do sleep 1; [ "$(cards)" != "$before" ] && return; done
  echo "Карточка менеджеру не пришла за 40 с: $2"; exit 1
}
cards() {
  curl -sf "$CHATS/ui/state" | "$PY" -c "import json,sys; d=json.load(sys.stdin)
print([m['mid'] for m in d['chats']['manager'] if m['bot'] and m['buttons']][-1:])"
}
answer() {  # менеджер отвечает на последнюю карточку своим текстом
  local mid; mid=$(cards | tr -d "[]' ")
  send "{\"who\":\"manager\",\"reply_to\":\"$mid\",\"text\":\"$1\"}"
  sleep 8  # модель выделяет факты в фоне
}

echo "1. Менеджер подключается, админка разрешает доступ"
send '{"who":"manager","text":"/manager"}'; sleep 2
curl -sf -c "$JAR" -b "$JAR" -o /dev/null -X POST "$ADMIN/login" -d 'token=sandbox'
curl -sf -b "$JAR" -o /dev/null -X POST "$ADMIN/connections/max:101/approve"

echo "2. Анна: вопрос, которого нет в базе"
send '{"who":"anna","start":true}'; sleep 2
say anna "Здравствуйте! А на тележках для покупок в ВЕЕР Молл можно разместить рекламу?"
answer "Добрый день! Нет, рекламы на тележках в ВЕЕР Молл нет. Из похожего есть брендирование парковочных талонов: поле 5×8 см, партия от 40 тысяч талонов. Пришлю вам пример талона."

echo "3. Ильдар: черновик бота мимо, менеджер отвечает сам и обещает уточнить"
send '{"who":"ildar","start":true}'; sleep 2
say ildar "Добрый день. В ДЕПО монтажникам машину где оставить, парковка платная?"
answer "Добрый день! Материалы и оборудование в ДЕПО завозят через служебный вход со стороны «Ленты» и Familia, там же разгружаются. Про оплату парковки для вашей машины уточню у ТРЦ и напишу."

echo "4. Анна: личное — в базу попасть не должно"
say anna "Ролики отправили вам на почту, поставите с понедельника?"
answer "Получили, всё в порядке, с понедельника ставим ваши ролики."

echo "5. Ильдар: цена, которой нет в прайсе, — утвердить не даст"
say ildar "А фотозону у ёлки в ДЕПО на неделю сколько стоит поставить?"
answer "Фотозона у ёлки в ДЕПО на неделю — 12 000 ₽, монтаж наш."

echo
curl -sf -b "$JAR" "$ADMIN/learn" | "$PY" -c "
import html, re, sys
t = html.unescape(re.sub(r'<[^>]+>', ' ', re.sub(r'<script.*?</script>', '', sys.stdin.read(), flags=re.S)))
m = re.search(r'Из переписки\s+(\d+)', t)
print(f'В «Обучении» кандидатов: {m.group(1) if m else 0} (ждём 3: тележки, завоз в ДЕПО, фотозона).')"
echo "Дальше на встрече: $ADMIN/learn → поправить вопрос про ДЕПО → «Утвердить»; тележки → «Утвердить»;"
echo "фотозона → «Утвердить» не пройдёт; «Обзор» → «Проверить бота»: «а на тележках в веере реклама у вас бывает?»;"
echo "«База знаний» → «История версий» → «Вернуть» прошлую версию → «Новый разговор» и тот же вопрос."
