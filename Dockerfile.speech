# Сначала собрать основной образ: docker compose build app.
ARG APP_IMAGE=ai-sales-assistant:local
FROM ${APP_IMAGE}

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /opt/speech \
    && python -m pip install --no-cache-dir uv==0.13.7

COPY requirements-speech.txt requirements-speech-overrides.txt /tmp/speech-install/
# Отдельный CPU-индекс не затягивает библиотеки CUDA в образ для обычного VPS.
RUN uv pip install --python /opt/speech/bin/python --index-url https://download.pytorch.org/whl/cpu \
        torch==2.15.0 \
    && uv pip install --python /opt/speech/bin/python \
        -r /tmp/speech-install/requirements-speech.txt \
        --override /tmp/speech-install/requirements-speech-overrides.txt \
    && uv cache clean \
    && rm -rf /tmp/speech-install \
    && mkdir -p /opt/speech-model \
    && chown 10001:10001 /opt/speech-model

# PyPI-вариант torchaudio для Linux требует libcudart; заменяем его CPU-сборкой.
RUN uv pip install --python /opt/speech/bin/python --index-url https://download.pytorch.org/whl/cpu \
        torchaudio==2.11.1+cpu \
    && uv pip install --python /opt/speech/bin/python setuptools==84.1.0 \
    && /opt/speech/bin/python -c 'import gigaam, torch; assert not torch.cuda.is_available()' \
    && uv cache clean

COPY app/speech_worker.py app/speech_models.py /app/app/
COPY tools/prepare_speech.py /app/tools/

ENV SPEECH_PYTHON=/opt/speech/bin/python \
    SPEECH_MODEL_DIR=/opt/speech-model \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2

USER 10001:10001
